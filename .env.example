# =============================================================================
# KoryoGraph — environment variables
# Copy to `.env.local` (repo root). `apps/web` loads the root file.
# Local Supabase values come from `npx supabase status -o env`.
# Anything left blank degrades honestly (Outbox, "no key" states) — never faked.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public base URL of the web app (dev server runs on :3100 — :3000 is taken on the build host)
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Root domain used by host → surface rewrites (koryograph.ai in prod)
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Cookie domain for cross-subdomain sessions (.koryograph.ai in prod; blank = host-only)
NEXT_PUBLIC_COOKIE_DOMAIN=
LOG_LEVEL=info

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by webhooks, jobs and src/server/admin/** only.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL (tests, seed, jobs/reports via `postgres`)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Google OAuth (optional; the button is hidden when unset)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Stripe (test mode) ------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee on Connect charges, in basis points (0 = none)
STRIPE_PLATFORM_FEE_BPS=0
# 1 = point the SDK at stripe-mock on :12111 (unit tests only)
STRIPE_MOCK=
STRIPE_MOCK_PORT=12111
# stripe.spec (@stripe): an onboarded test-mode Standard account connected to the platform
STRIPE_TEST_CONNECTED_ACCOUNT=

# --- AI (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=
# live | fixture | empty = live when OPENROUTER_API_KEY is set, else recorded dev fixtures (fixture is refused when NODE_ENV=production)
AI_TRANSPORT=
# Model per tier, chosen per deployment from OpenRouter's catalogue (no defaults are built in; see DECISIONS.md)
AI_MODEL_FAST=
AI_MODEL_FRONTIER=
AI_MODEL_VISION=
AI_MODEL_AUDIO=
AI_MODEL_EMBED=

# --- Communications (optional; otherwise messages land in the Outbox) --------
RESEND_API_KEY=
RESEND_FROM=KoryoGraph <no-reply@koryograph.ai>
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Web push (optional; in-app notifications only when unset)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Jobs & security ---------------------------------------------------------
# Bearer token for /api/jobs/* (Vercel Cron sends it in prod)
CRON_SECRET=dev-cron-secret-change-me
# HMAC secret for kiosk device tokens, signing links and API key hashing
APP_SECRET=dev-app-secret-change-me-32-chars-min

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=
